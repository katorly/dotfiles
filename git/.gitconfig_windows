[core]
	editor = \"[CHANGEME]\\Microsoft VS Code\\bin\\code\" --wait
	whitespace = fix,-indent-with-non-tab,trailing-space
	autocrlf = input
	excludesfile = ~/.gitignore_global
	attributesfile = ~/.gitattributes
[user]
	name = Katorly
	email = i@katorly.com
	signingkey = [CHANGEME]\\github_signing.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
[color]
    ui = auto
[pull]
	rebase = true
[fetch]
	prune = true
[push]
    default = simple
